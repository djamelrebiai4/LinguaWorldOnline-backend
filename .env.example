# Backend Environment Variables (Render)
# Copy to .env and fill in actual values. Never commit .env files.

PORT=3000
NODE_ENV=production

# Exact production frontend domain for CORS
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Comma-separated list of authorized domains that can call the API
# Example: https://lexiexplorer.com,https://lexiexplorer.vercel.app
AUTHORIZED_DOMAINS=https://your-frontend.vercel.app

# Supabase (backend-only, service_role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Supabase JWT verification
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq AI (backend-only)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
