{
  "name": "lexiexplorer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Lexi Explorer backend - Node.js Express API on Render",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:multiplayer": "ts-node-dev --respawn --transpile-only src/multiplayer-dev-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "ws": "^8.23.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.18.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
